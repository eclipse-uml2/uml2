pipeline {
	agent {
		label 'ubuntu-latest'
	}

	options {
		buildDiscarder(logRotator(numToKeepStr: '5'))
		disableConcurrentBuilds()
		skipDefaultCheckout false
	}

	tools {
		maven 'apache-maven-latest'
		jdk 'openjdk-jdk17-latest'
	}
	
	parameters {
		choice(
			name: 'BUILD_TYPE',
			choices: ['nightly', 'milestone', 'release', 'reload'],
			description: '''
<ul>
<li> N - Nightly build
<li> S - Stable / Milestone build
<li> R - Release build
<li> reload - to reload the parameter definitions from GIT and bypass promoting
</ul>'''
		)
 
		string(
			name: 'BUILD_ROOT',
			defaultValue: '${project.build.directory}/justj-sync',
			description: 'Root of intermediate site.'
		)

		string(
			name: 'BUILD_REMOTE',
			defaultValue: '-remote genie.uml2@projects-storage.eclipse.org:/home/data/httpd/download.eclipse.org/modeling/mdt/uml2',
			description: 'JustJ command line token to specify the root of the published builds.'
		)

		string(
			name: 'BUILD_COMMIT',
			defaultValue: '-commit https://github.com/eclipse-uml2/uml2/commit/${env.GIT_COMMIT}',
			description: 'JustJ command line token to specify the GIT commit of the published build.'
		)

		string(
			name: 'BUILD_TIMESTAMP',
			description: 'The timestamp / version qualifier of the new build. Leave blank for now.'
		)

		string(
			name: 'BUILD_URL',
			defaultValue: 'https://ci.eclipse.org/uml2/job/uml2-master/lastSuccessfulBuild/',
			description: 'URL of the source build job.'
		)

		string(
			name: 'BUILD_NUMBER',
			defaultValue: 'lastSuccessfulBuild',
			description: 'Sequence number of the source build job.'
		)

		string(
			name: 'JOB_NAME',
			defaultValue: 'uml2-master',
			description: 'Name of the source build job.'
		)
	}

	stages {
		stage('Display Parameters') {
			steps {
				script {
//					env.BUILD_TYPE = params.BUILD_TYPE
//					env.BUILD_NUMBER = params.BUILD_NUMBER
//					env.BUILD_ROOT = params.BUILD_ROOT
//					env.BUILD_REMOTE = params.BUILD_REMOTE
//					env.BUILD_COMMIT = params.BUILD_COMMIT
//					env.BUILD_TIMESTAMP = params.BUILD_TIMESTAMP
//					env.BUILD_URL = params.BUILD_URL
//					env.JOB_NAME = params.JOB_NAME
					echo "${params.BUILD_TYPE}"
					currentBuild.description = "${params.BUILD_TYPE}"
				}
			}
		}

		//
		//	Fetch the build to promote
		//
		stage('Copy Artifacts') {
			when {
				expression { return params.BUILD_TYPE != 'reload' && currentBuild.getPreviousBuild() != null }
			}
			steps {
				copyArtifacts(projectName: '${params.JOB_NAME}',
					selector: specific("${params.BUILD_NUMBER}"),
					target: '.',
					filter: 'p2repo.zip')
				sh 'unzip -ou p2repo.zip -d repository'
			}
		}
		stage('Build') {
			when {
				expression { return params.BUILD_TYPE != 'reload' && currentBuild.getPreviousBuild() != null }
			}
			steps {
				sshagent(['projects-storage.eclipse.org-bot-ssh']) {
					sh """
						mvn	\
							-f releng/org.eclipse.uml2.releng.tycho/pomPromoter.xml \
							--no-transfer-progress \
							"-DBUILD_COMMIT=${params.BUILD_COMMIT}" \
							-DBUILD_PROMOTE=../../repository \
							"-DBUILD_REMOTE=${params.BUILD_REMOTE}" \
							-DBUILD_ROOT=${params.BUILD_ROOT} \
							"-DBUILD_TIMESTAMP=${params.BUILD_TIMESTAMP}" \
							-DBUILD_TYPE=${params.BUILD_TYPE} \
							-DBUILD_URL=${params.BUILD_URL} \
							--show-version \
							clean \
							verify
						"""
				}
			}
		}
	}

	post {
		failure {
			mail to: 'ed@willink.me.uk', subject: "[UML2 CI] Build Failure ${currentBuild.fullDisplayName}", mimeType: 'text/plain',
body: "Project: ${JOB_NAME}\n\
Build Number: ${params.BUILD_NUMBER}\n\
Build URL: <${params.BUILD_URL}>\n\
Console: <${BUILD_URL}console>"
			archiveArtifacts allowEmptyArchive: true, artifacts: '**'
		}

		fixed {
			mail to: 'ed@willink.me.uk', subject: "[UML2 CI] Back to normal ${currentBuild.fullDisplayName}", mimeType: 'text/plain',
body: "Project: ${JOB_NAME}\n\
Build Number: ${params.BUILD_NUMBER}\n\
Build URL: <${params.BUILD_URL}>\n\
Console: <${BUILD_URL}console>"
		}

//		cleanup {
//			deleteDir()
//		}
	}
}
