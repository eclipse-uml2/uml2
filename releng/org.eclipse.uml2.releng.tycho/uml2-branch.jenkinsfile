pipeline {
	agent {
		label 'ubuntu-latest'
	}

	options {
		buildDiscarder(logRotator(numToKeepStr: '5'))
		disableConcurrentBuilds()
		skipDefaultCheckout false
	}

	tools {
		maven 'apache-maven-latest'
		jdk 'openjdk-jdk21-latest'
	}

	environment {
		BUILD_TIMESTAMP = sh(returnStdout: true, script: 'date +%Y%m%d%H%M').trim()
	}
	
	parameters {
		choice(
			name: 'BUILD_TYPE',
			choices: ['nightly', 'milestone', 'reload'],
			description: '''
<ul>
<li> N - Nightly build
<li> S - Stable / Milestone build
<li> reload - to reload the parameter definitions from GIT and bypass building
</ul>'''
		)
		
		string(
			name: 'BRANCH_NAME',
			defaultValue: 'master',
			description: 'Specify a bug branch name for example: (issue/123).'
		)
	}

	stages {
		//
		//	Set BUILD_TYPE in the Jenkins job description.
		//
		stage('Display Parameters') {
			steps {
				script {
					env.BUILD_TYPE = params.BUILD_TYPE
					def description = """
BUILD_TYPE=${env.BUILD_TYPE}
""".trim()
					echo description
					currentBuild.description = description.replace("\n", "<br/>")
				}
			}
		}
		//
		//	Do the regular project build and test.
		//
		stage('Build') {
			when {
				expression { return params.BUILD_TYPE != 'reload' && currentBuild.getPreviousBuild() != null }
			}
			steps {
				wrap([$class: 'Xvnc', takeScreenshot: false, useXauthority: true]) {
					sh '''
						mvn	\
							-f releng/org.eclipse.uml2.releng.tycho/pom.xml \
							--no-transfer-progress \
							-DBUILD_TYPE=${BUILD_TYPE} \
							--show-version \
							-Dorg.eclipse.equinox.p2.transport.ecf.retry=100 \
							clean \
							verify \
							-P${BUILD_TYPE} \
							-Psign
						cd releng/org.eclipse.uml2.build-feature/target/repository
						zip -r ../../../../p2repo.zip .
						'''
				}
				archiveArtifacts artifacts: 'releng/org.eclipse.uml2.build-feature/target/repository/**/*'
				archiveArtifacts allowEmptyArchive: true, artifacts: 'p2repo.zip'
			}
		}
		stage('Publish') {
			when {
				expression { return params.BUILD_TYPE != 'reload' && currentBuild.getPreviousBuild() != null }
			}
			steps {
				sshagent(['projects-storage.eclipse.org-bot-ssh']) {
					sh '''
						set -e
						set -x
						LOGIN="genie.uml2@projects-storage.eclipse.org"
						BUILDS="/home/data/httpd/download.eclipse.org/modeling/mdt/uml2/builds"
						ssh $LOGIN "cd $BUILDS; rm -rf archive/uml2-branch/next; mkdir -p archive/uml2-branch/next"
						scp -r p2repo.zip $LOGIN:$BUILDS/archive/uml2-branch/next/
						ssh $LOGIN "cd $BUILDS/archive/uml2-branch/next; unzip -ou p2repo.zip -d ."
						ssh $LOGIN "cd $BUILDS/archive/uml2-branch; mv latest prev; mv next latest; rm -rf prev latest/p2repo.zip"
					'''
				}
			}
		}
	}
	
	post {
		failure {
			mail to: 'ed@willink.me.uk', subject: "[UML2 CI] Build Failure ${currentBuild.fullDisplayName}", mimeType: 'text/plain',
body: "Project: ${env.JOB_NAME}\n\
Build Number: ${env.BUILD_NUMBER}\n\
Build URL: <${env.BUILD_URL}>\n\
Console: <${env.BUILD_URL}console>"
			archiveArtifacts allowEmptyArchive: true, artifacts: '**'
		}

		fixed {
			mail to: 'ed@willink.me.uk', subject: "[UML2 CI] Back to normal ${currentBuild.fullDisplayName}", mimeType: 'text/plain',
body: "Project: ${env.JOB_NAME}\n\
Build Number: ${env.BUILD_NUMBER}\n\
Build URL: <${env.BUILD_URL}>\n\
Console: <${env.BUILD_URL}console>"
		}

		always {
			junit allowEmptyResults: params.BUILD_TYPE == 'reload' || currentBuild.getPreviousBuild() == null, testResults: 'tests/*/target/**/surefire-reports/**/TEST-*.xml'
		}

//		cleanup {
//			deleteDir()
//		}
	}
}
