<plugin>

  <!-- Register UML 5.1.0 namespace (Eclipse) -->
  <extension point="org.eclipse.emf.ecore.generated_package">
    <package
       uri = "http://www.eclipse.org/uml2/5.1.0/UML"
       class = "org.eclipse.uml2.uml.UMLPackage" />
  </extension>

  <!-- Register OMG UML 2.5.1 namespace -->
  <extension point="org.eclipse.emf.ecore.generated_package">
    <package
       uri = "http://www.omg.org/spec/UML/20161101"
       class = "org.eclipse.uml2.uml.UMLPackage" />
  </extension>

  <!-- Content type for Eclipse UML 5.1.0 -->
  <extension point="org.eclipse.core.contenttype.contentTypes">
     <content-type
           base-type="org.eclipse.uml2.uml"
           file-extensions="uml"
           id="org.eclipse.uml2.uml_5_1_0"
           name="%_UI_UML_5_1_0_content_type"
           priority="normal">
        <describer
              class="org.eclipse.emf.ecore.xmi.impl.RootXMLContentHandlerImpl$Describer">
           <parameter
                 name="namespace"
                 value="http://www.eclipse.org/uml2/5.1.0/UML" />
           <parameter
                 name="kind"
                 value="xmi" />
        </describer>
     </content-type>

     <!-- Content type for OMG UML 2.5.1 -->
     <content-type
           base-type="org.eclipse.uml2.uml"
           file-extensions="xmi"
           id="org.omg.uml_2_5_1"
           name="%_UI_OMG_UML_2_5_1_content_type"
           priority="normal">
        <describer
              class="org.eclipse.emf.ecore.xmi.impl.RootXMLContentHandlerImpl$Describer">
           <parameter
                 name="namespace"
                 value="http://www.omg.org/spec/UML/20161101" />
           <parameter
                 name="kind"
                 value="xmi" />
        </describer>
     </content-type>
  </extension>

  <!-- Content parser for Eclipse UML 5.1.0 -->
  <extension point="org.eclipse.emf.ecore.content_parser">
     <parser
           contentTypeIdentifier="org.eclipse.uml2.uml_5_1_0"
           class="org.eclipse.uml2.uml.resources.uml251.internal.resource.UML510UMLResourceFactoryImpl" />
  </extension>

  <!-- Content parser for OMG UML 2.5.1 -->
  <extension point="org.eclipse.emf.ecore.content_parser">
     <parser
           contentTypeIdentifier="org.omg.uml_2_5_1"
           class="org.eclipse.uml2.uml.resources.uml251.internal.resource.UML510UMLResourceFactoryImpl" />
  </extension>

</plugin>
